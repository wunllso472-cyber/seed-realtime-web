# 复制为 .env 后按需填写
# 服务端 API Key：设置页留空时使用这里的 Key（局域网开放时，所有访问者都会共用它）
SEED_API_KEY=
PORT=3000
# 127.0.0.1 = 仅本机访问；0.0.0.0 = 允许局域网其他机器访问
HOST=127.0.0.1
# HTTPS：auto = certs/ 下有证书就启用；1 = 强制启用；0 = 关闭。局域网访问必须启用（npm run cert 生成证书）
HTTPS=auto
# 代理口令：设置后，不带自己 API Key 的客户端（如 Rokid 眼镜智能体）必须在 proxy.connect 中带上相同的 token
# 才能使用上面的 SEED_API_KEY。部署到公网时务必设置一个足够长的随机字符串。
PROXY_TOKEN=
